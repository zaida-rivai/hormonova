---
import Benefit from "@/components/Benefit.astro";
import CommonHeader from "@/components/CommonHeader.astro";
import JobPosts from "@/components/service/JobPosts.astro";
import Solutions from "@/components/service/Solutions.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const call_to_action = await getEntry("sections", "call-to-action");
const service = await getEntry("service", "index");
const {
  title,
  page_description,
  button,
  meta_title,
  description,
  image,
  integration,
  our_solutions,
  our_benefits,
  job_post,
} = service.data;
const jobposts = await getSinglePage("careers");
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <CommonHeader
    title={title}
    page_description={page_description}
    button={button}
    image={image}
  />
</Base>
