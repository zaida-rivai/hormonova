---
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
const { services } = Astro.props;

import { AiFillCheckCircle } from "react-icons/ai";
---

<section class="services section-bordered">
  <div class="container">
    {
      services.map((item: any, i: number) => (
        <div class="row relative mb-20 justify-center lg:mb-[120px]">
          <div class="grained-bg absolute left-0 top-0 h-full w-full opacity-[0.16]">
            <img src="/images/common-bg.png" alt="" />
          </div>
          <div class="lg:col-11 xl:col-10">
            <div class="row items-center">
              <div
                class={`mx-0 lg:col-7 ${
                  i % 2 === 0 ? "lg:order-1" : "lg:order-2"
                }`}
              >
                <Image
                  width={741}
                  height={654}
                  class="rounded-lg"
                  alt=""
                  src={item.image}
                  style={{ objectFit: "contain", background: "rgba(0,0,0,0)" }}
                />
              </div>
              <div
                class={`mt-10 lg:col-5 lg:pl-6 xl:mt-0 ${
                  i % 2 === 0 ? "lg:order-2" : "lg:order-1"
                }`}
              >
                <h2 class="section-title" set:html={markdownify(item.title)} />
                <p class="mb-8">{item.content}</p>
                <ul class="mb-10">
                  {item.list &&
                    item.list.map((item: any) => (
                      <li class="my-1.5 px-0">
                        {" "}
                        <AiFillCheckCircle className="inline fill-primary text-white" />
                        {item}
                      </li>
                    ))}
                </ul>
                {item.button && item.button.enable && (
                  <a href={item.button.link} class="btn btn-primary">
                    {item.button.label}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
