---
import BlogCard from "@/components/BlogCard.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { Image } from "astro:assets";
import { Calendar, ChevronRight } from "react-feather";

const { featuredPost } = Astro.props;
---

<section class="bg-gradient pb-12 pt-28 lg:pb-20 lg:pt-[206px]">
  <div class="container">
    <div class="row justify-center">
      <div class="mb-20 text-center lg:col-6">
        <h1 class="h1-lg highlighted"><span>Featured</span> Posts</h1>
      </div>

      <div class="row items-center justify-center lg:col-11 xl:col-10">
        <div class="mb-10 lg:col-5 lg:order-2 lg:mb-0">
          <Image
            src={featuredPost[0].data.image}
            alt=""
            height={510}
            width={680}
            class="w-full rounded-xl shadow"
          />
        </div>
        <div class="lg:col-5 lg:order-1">
          <h2 class="h3 mb-4">
            {featuredPost[0].data.title}
          </h2>
          <ul class="-mt-2 mb-6 flex flex-wrap items-center">
            <li>
              <a class="inline-flex items-center space-x-2">
                <Image
                  height={32}
                  width={32}
                  class="h-8 w-8 rounded-full"
                  src="/images/author-avatar.png"
                  alt=""
                />
                <span>{featuredPost[0].data.author}</span>
              </a>
            </li>
            <li>
              <div class="ml-2 inline-flex items-center">
                <Calendar />
                <span class="ml-1">{dateFormat(featuredPost[0].data.date)}</span
                >
              </div>
            </li>
          </ul>

          <a
            class="inline-flex items-center justify-center text-primary transition-all duration-200"
            href={`/blog/${featuredPost[0].slug}`}
          >
            <span
              class="mr-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary text-xs text-white"
            >
              <ChevronRight />
            </span>
            learn more
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<section>
  <div class="container mt-0">
    <div class="row justify-center">
      <div class="row gy-4 -mt-6 lg:col-11 xl:col-10">
        {
          featuredPost
            .slice(1, featuredPost.length)
            .map((item: any) => <BlogCard post={item} />)
        }
      </div>
    </div>
  </div>
</section>
