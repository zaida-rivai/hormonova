---
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";

const { our_company } = Astro.props;
---

<section class="section-bordered mt-20">
  <div class="container">
    {
      our_company.map((item: any, i: number) => (
        <div class="row relative mb-20 justify-center lg:mb-[120px]">
          <div class="grained-bg absolute left-0 top-0 h-full w-full opacity-[0.16]">
            <img src="/images/common-bg.png" alt="" />
          </div>
          <div class="lg:col-10">
            <div class="row gx-5 items-center">
              <div
                class={`mb-6 lg:col-7 lg:order-2 lg:mb-0 ${
                  i % 2 === 0 ? "lg:order-2" : "lg:order-1"
                }`}
              >
                <div class="rounded-xl border border-border p-6">
                  <Image
                    height={384}
                    width={685}
                    class="rounded-xl border border-border drop-shadow-[0px_4px_54px_rgba(0,0,0,0.08)]"
                    src={item.image}
                    alt=""
                  />
                </div>
              </div>
              <div
                class={`order-2 lg:col-5 ${
                  i % 2 === 0 ? "lg:order-1" : "lg:order-2"
                }`}
              >
                <h2 class="section-title" set:html={markdownify(item.title)} />
                <p class="mb-8">{item.content}</p>
                {item.button.enable && (
                  <a class="btn btn-primary" href={item.button.link}>
                    {item.button.label}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
