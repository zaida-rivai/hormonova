---
import { Image } from "astro:assets";
import BlogCard from "@/components/BlogCard.astro";
import config from "@/config/config.json";
import Disqus from "@/function-components/Disqus";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import similerItems from "@/lib/utils/similarItems";
import { Calendar } from "react-feather";
import type { CollectionKey } from "astro:content";

const { blog_folder } = config.settings;
const posts = await getSinglePage(blog_folder as CollectionKey);
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.slug);
const { Content } = await post.render();
const { title, author, categories, image, date } = post.data;
---

<section class="bg-gradient pb-12 pt-28 lg:pb-20 lg:pt-[206px]">
  <div class="container">
    <div class="row justify-center">
      <div class="lg:col-8">
        <h1 class="h2 mb-5">{title}</h1>
        <div class="mb-10 flex flex-wrap items-center justify-center">
          <ul class="flex flex-wrap items-center">
            <li class="my-2 mr-4">
              <a class="inline-flex items-center space-x-2 text-primary">
                <Image
                  height={32}
                  width={32}
                  class="h-8 w-8 rounded-full"
                  src="/images/author-avatar.png"
                  alt=""
                  style={{ objectFit: "contain" }}
                />
                <span>{author}</span>
              </a>
            </li>
            <li class="my-2 mr-4">
              <div class="inline-flex items-center space-x-2">
                <Calendar />
                <span>{dateFormat(date)}</span>
              </div>
            </li>
            <li class="my-2 mr-4">
              <div class="inline-flex items-center space-x-2">
                <svg
                  class="h-6 w-6 rounded-full"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 19C14.1217 19 16.1566 18.1571 17.6569 16.6569C19.1571 15.1566 20 13.1217 20 11C20 8.87827 19.1571 6.84344 17.6569 5.34315C16.1566 3.84285 14.1217 3 12 3C9.87827 3 7.84344 3.84285 6.34315 5.34315C4.84285 6.84344 4 8.87827 4 11C4 13.1217 4.84285 15.1566 6.34315 16.6569C7.84344 18.1571 9.87827 19 12 19ZM12 1C13.3132 1 14.6136 1.25866 15.8268 1.7612C17.0401 2.26375 18.1425 3.00035 19.0711 3.92893C19.9997 4.85752 20.7362 5.95991 21.2388 7.17317C21.7413 8.38642 22 9.68678 22 11C22 13.6522 20.9464 16.1957 19.0711 18.0711C17.1957 19.9464 14.6522 21 12 21C6.47 21 2 16.5 2 11C2 8.34784 3.05357 5.8043 4.92893 3.92893C6.8043 2.05357 9.34784 1 12 1ZM12.5 6V11.25L17 13.92L16.25 15.15L11 12V6H12.5Z"
                    fill="currentColor"></path>
                </svg>
                <span>{readingTime(post.body)}</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
      <div class="-mb-[120px] lg:col-10">
        <Image
          height={490}
          width={960}
          class="w-full rounded-xl shadow"
          src={image}
          alt=""
        />
      </div>
    </div>
  </div>
</section>
<div class="container mt-32 md:mt-[158px]">
  <div class="row justify-center">
    <div class="content lg:col-8">
      <Content />
    </div>
    <div class="lg:col-8">
      <div class="mt-20">
        <Disqus client:load />
      </div>
    </div>
  </div>
</div>

<section class="section-bordered">
  <div class="container">
    <div class="row relative justify-center">
      <div
        class="grained-bg absolute left-0 top-0 h-full w-full opacity-[0.16]"
      >
        <img src="/images/common-bg.png" alt="" />
      </div>
      <div class="lg:col-11 xl:col-10">
        <h2 class="h3 mb-8">Further reading</h2>
        <div class="row gy-4">
          {
            similarPosts[0]
              .slice(0, 3)
              .map((item: any) => <BlogCard post={item} />)
          }
        </div>
      </div>
    </div>
  </div>
</section>
